<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smokédex - Curated Cannabis Culture</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
</head>
<body class="home-page">

    <header class="site-header">
        <a href="/" class="logo-link">
            <div class="logo">SMOKÉDEX</div>
        </a>
        <nav class="main-nav">
            <a href="https://shop.smokedex.com" target="_blank">Store</a>
            <a href="about.html">About</a>
            <a href="contact.html">Contact</a>
            <a href="terms.html">Terms</a>
        </nav>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open navigation menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
        </button>
    </header>

    <main class="dex-container">
        {{BRAND_CARDS}}

        <!-- All Brands Card -->
        <section class="brand-card theme-onboarding" id="all-brands">
            <div class="card-content">
                <a href="https://shop.smokedex.com" target="_blank" class="sprite-link">
                    <div class="sprite-container">
                        <img src="assets/smokedex-shop.png" alt="SMOKÉDEX SHOP" class="sprite-image">
                    </div>
                </a>
                <div class="info-container">
                    <a href="brands/onboarding.html" class="brand-name-link">
                        <h2 class="brand-name">SMOKÉDEX Shop</h2>
                    </a>
                    <p class="brand-data">See all the best brands in our store!</p>
                    <a href="https://shop.smokedex.com" target="_blank" class="merch-button">View Store</a>
                </div>
            </div>
        </section>

        <!-- Onboarding Card -->
        <section class="brand-card theme-onboarding" id="onboarding">
            <div class="card-content">
                <a href="brands/onboarding.html" class="sprite-link">
                    <div class="sprite-container">
                        <img src="assets/onboarding.svg" alt="Feature Your Brand" class="sprite-image">
                    </div>
                </a>
                <div class="info-container">
                    <a href="brands/onboarding.html" class="brand-name-link">
                        <h2 class="brand-name">Feature Your Brand</h2>
                    </a>
                    <p class="brand-data"><strong>TYPE:</strong> Your Brand Here</p>
                    <p class="brand-data"><strong>DESC:</strong> Ready to join the Smokédex? Click here to learn how to get your brand featured on our platform.</p>
                    <a href="brands/onboarding.html" class="merch-button">Get Started</a>
                </div>
            </div>
        </section>
    </main>

    <div class="mobile-menu-overlay" id="mobile-menu-overlay">
        <button class="close-menu-btn" id="close-menu-btn" aria-label="Close navigation menu">&times;</button>
        <nav class="mobile-nav">
            <a href="/">Home</a>
            <a href="https://shop.smokedex.com" target="_blank">Store</a>
            <a href="about.html">About</a>
            <a href="contact.html">Contact</a>
            <a href="terms.html">Terms</a>
        </nav>
    </div>

    <script src="js/script.js"></script>
</body>
</html>
